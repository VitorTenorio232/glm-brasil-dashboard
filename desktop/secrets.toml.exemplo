# Para acessar os dados históricos (Climatologia, Séries, Ranking):
# 1. Renomeie este arquivo para  secrets.toml  (na mesma pasta do FlashView.exe)
# 2. Preencha os valores abaixo.
# Nunca envie o secrets.toml a ninguém e nunca faça commit dele no GitHub.

HF_TOKEN = "hf_COLE_SEU_TOKEN_AQUI"
FLASH_VIEW_HF_REPO = "VitorLSR/flash-view-glm-data"
FLASH_VIEW_HF_PREFIX = ""

# Opcional: usar uma pasta local em vez do Hugging Face (funciona offline)
# FLASH_VIEW_DATA_ROOT = "C:/Users/SEU_USUARIO/Dashboard GLM/GLM_Process/OUTPUT"
