# Copie para .streamlit/secrets.toml. NÃO envie secrets.toml ao GitHub.
EE_PROJECT = "seu-projeto-google-cloud"
EE_MUNICIPALITIES_ASSET = "projects/seu-projeto/assets/municipios_brasil"
# Em execução local autenticada com `earthengine authenticate`, os campos abaixo podem ficar ausentes.
# Para deploy sem interação, prefira ADC/service account configurado na plataforma.

# Opcional para deploy por service account (não comite valores reais):
# EE_SERVICE_ACCOUNT = "conta@seu-projeto.iam.gserviceaccount.com"
# EE_PRIVATE_KEY_JSON = '''{"type":"service_account", "...":"..."}'''
