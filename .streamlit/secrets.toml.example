# Copie para .streamlit/secrets.toml APENAS no seu computador.
# NUNCA envie o secrets.toml real ao GitHub (ele está no .gitignore).
# No Streamlit Community Cloud, cole este conteúdo em: App → Settings → Secrets.

# --- Base histórica (Climatologia, Séries temporais e Ranking) ---------------
# Dataset privado no Hugging Face com 01_HOURLY, 02_DAILY, 03_MONTHLY, 04_YEARLY e 05_RANKINGS.
FLASH_VIEW_HF_REPO = "VitorLSR/flash-view-glm-data"

# Token do Hugging Face com permissão de LEITURA no Dataset.
HF_TOKEN = "hf_COLE_SEU_TOKEN_AQUI"

# Deixe vazio se as pastas estiverem na raiz do Dataset; se estiverem em OUTPUT/, use "OUTPUT".
FLASH_VIEW_HF_PREFIX = ""

# Alternativa local (sem Hugging Face): pasta com a mesma estrutura de diretórios.
# FLASH_VIEW_DATA_ROOT = "C:/dados/flash-view"

# --- Opcional: Google Earth Engine (scripts auxiliares; o site não depende disto) ---
# EE_PROJECT = "seu-projeto-google-cloud"
# EE_MUNICIPALITIES_ASSET = "projects/seu-projeto/assets/municipios_brasil"
# EE_SERVICE_ACCOUNT = "conta@seu-projeto.iam.gserviceaccount.com"
# EE_PRIVATE_KEY_JSON = '''{"type":"service_account", "...":"..."}'''
